{
  "schema_version": 1,
  "profile_id": "minecraft.java",
  "version": 1,
  "display_name": "Minecraft: Java Edition",
  "inherits": "generic.default",
  "detection": {
    "executables": ["javaw.exe"],
    "window_title_patterns": ["(?i)Minecraft(?:[ :]|$)"],
    "window_class_patterns": ["(?i)LWJGL"],
    "minimum_confidence": 0.8,
    "status": "metadata_pending_verification"
  },
  "chat": {
    "default_anchor": "bottom_left",
    "player_message_separators": [">", ":"],
    "direction_markers": [],
    "announce_outbound": false,
    "announce_system": false,
    "username_pattern": "^[A-Za-z0-9_]{1,16}$",
    "player_colors": ["#FFFFFF"],
    "system_colors": ["#FFFF55", "#55FF55", "#FF5555"],
    "outgoing_colors": [],
    "item_link_patterns": ["\\[[^\\]\\r\\n]{1,80}\\]"]
  },
  "resources": {
    "glossary_id": null,
    "system_patterns": "system_patterns.json"
  },
  "layouts": {
    "strategy": "user_calibration_with_profile_hints",
    "default_anchor": "bottom_left",
    "presets": ["default", "large-chat", "custom-scale", "ultrawide"]
  },
  "preprocess": {
    "scale": 2,
    "contrast": 1.3,
    "sharpen": true,
    "text_colors": ["#FFFFFF", "#FFFF55", "#55FF55", "#FF5555"]
  }
}
